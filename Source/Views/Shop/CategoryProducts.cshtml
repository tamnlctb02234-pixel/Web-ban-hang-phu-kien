@model IEnumerable<ASM1_SOF1022.Models.SanPham>

@{
    ViewData["Title"] = ViewBag.TenDanhMuc;
}

<style>

    body {
        background-color: #fffafc;
    }

    .page-title {
        color: #ff4d8d;
        font-weight: bold;
    }

    .product-card {
        border: none;
        border-radius: 22px;
        overflow: hidden;
        background: white;
        transition: .3s;
    }

        .product-card:hover {
            transform: translateY(-5px);
        }

    .product-img {
        width: 100%;
        height: 250px;
        object-fit: cover;
    }

    .price {
        color: #ff4d6d;
        font-size: 20px;
        font-weight: bold;
    }

    .btn-pink {
        background: #ff4d8d;
        color: white;
        border-radius: 12px;
        border: none;
    }

        .btn-pink:hover {
            background: #ff2f78;
            color: white;
        }

    .category-badge {
        background: #ffe0eb;
        color: #ff4d8d;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 13px;
    }

</style>

<div class="container py-5">

    <div class="text-center mb-5">

        <h1 class="page-title">
            📂 @ViewBag.TenDanhMuc
        </h1>

        <p class="text-muted">
            Danh sách sản phẩm thuộc danh mục này
        </p>

    </div>

    <a asp-controller="Shop" 
        asp-action="Categories" 
        class="btn btn-primary mb-4">
        ⬅ Quay lại
    </a>

    <div class="row g-4">

        @foreach (var item in Model)
        {
            <div class="col-md-3">

                <div class="card shadow-sm product-card h-100">

                    <img src="~/images/@item.HinhAnh"
                         class="product-img" />

                    <div class="card-body d-flex flex-column">

                        <div class="mb-2">

                            <span class="category-badge">
                                @item.MaDanhMucNavigation?.TenDanhMuc
                            </span>

                        </div>

                        <h5 class="fw-bold">
                            @item.TenSanPham
                        </h5>

                        <p class="text-muted small flex-grow-1">
                            @item.MoTa
                        </p>

                        <div class="price mb-3">
                            @String.Format("{0:N0}", item.Gia) VNĐ
                        </div>

                        <a asp-controller="Shop"
                           asp-action="Details"
                           asp-route-id="@item.MaSanPham"
                           class="btn btn-pink">

                            Xem chi tiết

                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

</div>