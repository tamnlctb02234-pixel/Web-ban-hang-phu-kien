@model ASM1_SOF1022.Models.SanPham

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<style>

    .product-img {
        width: 100%;
        border-radius: 25px;
        object-fit: cover;
    }

    .price {
        color: #ff4d6d;
        font-size: 32px;
        font-weight: bold;
    }

    .btn-buy {
        background-color: #ff4d8d;
        color: white;
        border-radius: 14px;
        padding: 12px 25px;
        border: none;
    }

        .btn-buy:hover {
            background-color: #ff2f78;
            color: white;
        }

</style>

<div class="container py-5">

    <div class="row g-5">

        <!-- HÌNH -->
        <div class="col-md-6">

            <img src="~/images/@Model.HinhAnh"
                 class="product-img shadow" />

        </div>

        <!-- THÔNG TIN -->
        <div class="col-md-6">

            <span class="badge bg-danger mb-3">

                @Model.MaDanhMucNavigation?.TenDanhMuc

            </span>

            <h1 class="fw-bold mb-3">

                @Model.TenSanPham

            </h1>

            <div class="price mb-4">

                @String.Format("{0:N0}", Model.Gia) VNĐ

            </div>

            <p class="text-muted mb-4">

                @Model.MoTa

            </p>

            <p>

                <strong>Số lượng còn:</strong>
                @Model.SoLuong

            </p>

            <a asp-controller="Cart"
               asp-action="AddToCart"
               asp-route-id="@Model.MaSanPham"
               class="btn btn-buy">

                🛒 Thêm vào giỏ hàng

            </a>

            <a asp-controller="DanhGias"
               asp-action="ByProduct"
               asp-route-id="@Model.MaSanPham"
               class="btn btn-outline-dark">

                ⭐ Xem đánh giá
            </a>

            </div>

        </div>

    </div>