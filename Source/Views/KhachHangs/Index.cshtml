@model IEnumerable<ASM1_SOF1022.Models.KhachHang>

@{
    ViewData["Title"] = "Quản lý khách hàng";
}

<style>

    .page-title {
        color: #ff4d8d;
        font-weight: bold;
    }

    .btn-pink {
        background-color: #ff4d8d;
        color: white;
        border-radius: 12px;
        padding: 10px 18px;
        border: none;
    }

        .btn-pink:hover {
            background-color: #ff2f78;
            color: white;
        }

    .table thead {
        background-color: #fff0f5;
    }

        .table thead th {
            color: #ff4d8d;
        }

</style>

<div class="container mt-5">

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["success"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["error"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="page-title">
                👤 Quản lý khách hàng
            </h2>

            <p class="text-muted">
                Danh sách khách hàng trong hệ thống
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-pink">

            + Thêm khách hàng

        </a>

    </div>

    <div class="card shadow border-0 rounded-4">

        <div class="card-body">

            <table class="table align-middle">

                <thead>
                    <tr>
                        <th>Họ tên</th>
                        <th>Email</th>
                        <th>SĐT</th>
                        <th>Địa chỉ</th>
                        <th>Vai trò</th>
                        <th width="220">Chức năng</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>@item.HoTen</td>

                            <td>@item.Email</td>

                            <td>@item.SoDienThoai</td>

                            <td>@item.DiaChi</td>

                            <td>
                                <span class="badge bg-primary">
                                    @item.MaVaiTroNavigation?.TenVaiTro
                                </span>
                            </td>

                            <td>

                                <a asp-action="Details"
                                   asp-route-id="@item.MaKhachHang"
                                   class="btn btn-info btn-sm">

                                    Chi tiết

                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.MaKhachHang"
                                   class="btn btn-warning btn-sm">

                                    Sửa

                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.MaKhachHang"
                                   class="btn btn-danger btn-sm">

                                    Xóa

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>