@model ASM1_SOF1022.Models.KhachHang

@{
    ViewData["Title"] = "Sửa khách hàng";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card shadow border-0 rounded-4">

                <div class="card-body p-4">

                    <h2 class="text-center text-warning mb-4">
                        ✏️ Sửa khách hàng
                    </h2>

                    <form asp-action="Edit">

                        <input type="hidden"
                               asp-for="MaKhachHang" />

                        <div class="mb-3">
                            <label>Họ tên</label>

                            <input asp-for="HoTen"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label>Email</label>

                            <input asp-for="Email"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label>Mật khẩu</label>

                            <input asp-for="MatKhau"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label>SĐT</label>

                            <input asp-for="SoDienThoai"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label>Địa chỉ</label>

                            <input asp-for="DiaChi"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label>Vai trò</label>

                            <select asp-for="MaVaiTro"
                                    asp-items="ViewBag.MaVaiTro"
                                    class="form-select">
                            </select>
                        </div>

                        <button type="submit"
                                class="btn btn-warning w-100">

                            Lưu thay đổi

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>