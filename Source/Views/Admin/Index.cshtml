@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-5">

        <div>
            <h1 class="fw-bold text-danger">
                🛠️ ADMIN DASHBOARD
            </h1>

            <p class="text-muted">
                Hệ thống quản lý Bear & Bunny
            </p>
        </div>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-dark rounded-pill px-4">

            ← Trang chủ

        </a>

    </div>


    <!-- THỐNG KÊ -->

    <div class="row g-4 mb-5">

        <div class="col-md-3">

            <a asp-controller="SanPhams"
                asp-action="Index"
                class="text-decoration-none">

                <div class="admin-box bg-light">
                    🛍️
                    <p class="mt-2 mb-0">
                        Sản phẩm
                    </p>
                </div>

            </a>

        </div>


        <div class="col-md-3">

            <a asp-controller="DonHangs" 
                class="text-decoration-none">

                

                <div class="admin-box bg-light">
                        📦
                    <p class="mt-2 mb-0">
                        Đơn hàng
                    </p>
                </div>

            </a>

        </div>


        <div class="col-md-3">

            <a asp-controller="KhachHangs"
               asp-action="Index"
               class="text-decoration-none">

                <div class="admin-box bg-light">

                    👤

                    <p class="mt-2 mb-0">
                        Khách hàng
                    </p>

                </div>

            </a>

        </div>


        <div class="col-md-3">

            <a asp-controller="DanhGias"
                asp-action="Index"
                class="text-decoration-none">

                <div class="admin-box bg-light">
                    ⭐
                    <p class="mt-2 mb-0">
                        Đánh giá
                    </p>
                </div>

            </a>

        </div>

    </div>


    <!-- QUẢN LÝ -->

    <div class="card border-0 shadow rounded-4">

        <div class="card-body p-4">

            <h3 class="fw-bold mb-4">
                ⚡ Quản lý nhanh
            </h3>

            <div class="row g-4">

                <div class="col-md-3">

                    <a asp-controller="SanPhams"
                       asp-action="Index"
                       class="text-decoration-none">

                        <div class="admin-box bg-light">

                            🛍️

                            <p class="mt-2 mb-0">
                                Sản phẩm
                            </p>

                        </div>

                    </a>

                </div>


                <div class="col-md-3">

                    <a asp-controller="DonHangs"
                       asp-action="Index"
                       class="text-decoration-none">

                        <div class="admin-box bg-light">

                            📦

                            <p class="mt-2 mb-0">
                                Đơn hàng
                            </p>

                        </div>

                    </a>

                </div>


                <div class="col-md-3">

                    <a asp-controller="DanhMucs"
                       asp-action="Index"
                       class="text-decoration-none">

                        <div class="admin-box bg-light">

                            📂

                            <p class="mt-2 mb-0">
                                Danh mục
                            </p>

                        </div>

                    </a>

                </div>


                <div class="col-md-3">

                    <a asp-controller="KhuyenMais"
                       asp-action="Index"
                       class="text-decoration-none">

                        <div class="admin-box bg-light">

                            🎁

                            <p class="mt-2 mb-0">
                                Khuyến mãi
                            </p>

                        </div>

                    </a>

                </div>

                <div class="col-md-3">

                    <div class="card border-0 shadow rounded-4">

                        <div class="card-body text-center p-4">

                            <div class="fs-1">
                                💰
                            </div>

                            <h4 class="fw-bold mt-3 text-danger">

                                @String.Format("{0:N0}",
                                    ViewBag.TotalRevenue) VNĐ

                            </h4>

                            <p class="text-muted">
                                Doanh thu
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<style>

    .admin-box {
        border-radius: 20px;
        padding: 35px 20px;
        text-align: center;
        font-size: 25px;
        font-weight: bold;
        transition: 0.3s;
    }

        .admin-box:hover {
            transform: translateY(-5px);
            background-color: #ffe6f0 !important;
        }

</style>