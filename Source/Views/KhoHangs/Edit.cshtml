@model ASM1_SOF1022.Models.KhoHang

@{
    ViewData["Title"] = "Cập nhật kho hàng";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-lg-6">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-header bg-dark text-white rounded-top-4 p-4">
                    <h3 class="mb-0">
                        📦 Cập nhật kho hàng
                    </h3>
                </div>

                <div class="card-body p-4">

                    <form asp-action="Edit" method="post">

                        <input type="hidden" asp-for="MaKho" />

                        <!-- TÊN SẢN PHẨM -->
                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Tên sản phẩm
                            </label>

                            <input value="@Model.MaSanPhamNavigation?.TenSanPham"
                                   class="form-control form-control-lg"
                                   readonly />
                        </div>

                        <!-- SỐ LƯỢNG -->
                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Số lượng tồn kho
                            </label>

                            <input asp-for="SoLuongTon"
                                   class="form-control form-control-lg"
                                   min="0" />

                            <span asp-validation-for="SoLuongTon"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- NGÀY CẬP NHẬT -->
                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Ngày cập nhật
                            </label>

                            <input asp-for="NgayCapNhat"
                                   class="form-control"
                                   readonly />
                        </div>

                        <!-- BUTTON -->
                        <div class="d-flex justify-content-between">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary px-4">

                                ← Quay lại
                            </a>

                            <button type="submit"
                                    class="btn btn-primary px-4">

                                💾 Lưu thay đổi
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}