@model IEnumerable<ASM1_SOF1022.Models.KhoHang>

<div class="container mt-5">

    <h2 class="fw-bold mb-4">
        📦 Kho hàng
    </h2>

    @if(TempData["success"] != null)
    {
        <div class="alert alert-success">
            @TempData["success"]
        </div>
    }

    <div class="card shadow border-0 rounded-4">

        <div class="card-body">

            <table class="table">

                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Số lượng tồn</th>
                        <th>Ngày cập nhật</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @item.MaSanPhamNavigation?.TenSanPham
                            </td>

                            <td>
                                @item.SoLuongTon
                            </td>

                            <td>
                                @item.NgayCapNhat
                            </td>

                            <td>

                                <a asp-action="Edit"
                                   asp-route-id="@item.MaKho"
                                   class="btn btn-warning btn-sm">

                                    Cập nhật

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>