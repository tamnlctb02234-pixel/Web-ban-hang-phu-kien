@model IEnumerable<ASM1_SOF1022.Models.KhoHang>

<div class="container mt-5">

    <h2 class="fw-bold mb-4">
        📦 Kho hàng
    </h2>

    <div class="mb-3">

        <a
            asp-controller="PhieuNhaps"
            asp-action="Index"
           class="btn btn-success">

            📥 Phiếu nhập

        </a>

        <a asp-action="LowStock"
           class="btn btn-warning">

            ⚠️ Sắp hết hàng

        </a>

    </div>

    @* ĐÃ THÊM CLASS auto-close-alert ĐỂ JAVASCRIPT NHẬN DIỆN *@
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show auto-close-alert" role="alert">
            @TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow border-0 rounded-4">

        <div class="card-body">

            <table class="table">

                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Số lượng tồn</th>
                        <th>Ngày cập nhật</th>
                        <th>Chức năng</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @item.MaSanPhamNavigation?.TenSanPham
                            </td>

                            <td>
                                @item.SoLuongTon
                            </td>

                            <td>
                                @item.NgayCapNhat
                            </td>

                            <td>

                                <a asp-action="Edit"
                                   asp-route-id="@item.MaKho"
                                   class="btn btn-warning btn-sm">

                                    Cập nhật

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@* ĐOẠN SCRIPT TỰ ĐỘNG ĐÓNG THÔNG BÁO SAU 2.5 GIÂY *@
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var alerts = document.querySelectorAll('.auto-close-alert');
            alerts.forEach(function (alert) {
                setTimeout(function () {
                    var bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                }, 2500); // 2500 mili giây = 2.5 giây
            });
        });
    </script>
}