@model IEnumerable<ASM1_SOF1022.Models.DanhMuc>

@{
    ViewData["Title"] = "Danh mục";
}

<style>

    body {
        background-color: #fffafc;
    }

    .category-card {
        background: white;
        border-radius: 25px;
        box-shadow: 0 10px 30px rgba(255, 77, 141, 0.08);
        padding: 30px;
    }

    .page-title {
        color: #ff4d8d;
        font-weight: bold;
    }

    .btn-pink {
        background: #ff4d8d;
        border: none;
        color: white;
        border-radius: 12px;
        padding: 10px 18px;
        font-weight: 600;
    }

        .btn-pink:hover {
            background: #ff2f78;
            color: white;
        }

    .table thead {
        background: #fff0f6;
    }

</style>

<div class="container py-5">

    <div class="category-card">

        @if (TempData["success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">

                @TempData["success"]

                <button type="button" class="btn-close" data-bs-dismiss="alert">
                </button>

            </div>
        }

        @if (TempData["error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">

                @TempData["error"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>
                <h2 class="page-title">
                    📂 Danh mục sản phẩm
                </h2>

                <p class="text-muted mb-0">
                    Quản lý danh mục của Bear & Bunny
                </p>
            </div>

            <a asp-action="Create"
               class="btn btn-pink">

                ➕ Thêm danh mục

            </a>

        </div>

        <table class="table align-middle table-hover">

            <thead>
                <tr>
                    <th>Mã danh mục</th>
                    <th>Tên danh mục</th>
                    <th width="180">Chức năng</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            @item.MaDanhMuc
                        </td>

                        <td class="fw-semibold">
                            @item.TenDanhMuc
                        </td>

                        <td>

                            <a asp-action="Edit"
                               asp-route-id="@item.MaDanhMuc"
                               class="btn btn-warning btn-sm">

                                Sửa

                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.MaDanhMuc"
                               class="btn btn-danger btn-sm">

                                Xóa

                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>
@* ĐOẠN SCRIPT TỰ ĐỘNG ĐÓNG THÔNG BÁO SAU 2.5 GIÂY *@
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var alerts = document.querySelectorAll('.auto-close-alert');
            alerts.forEach(function (alert) {
                setTimeout(function () {
                    var bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                }, 2500); // 2500 mili giây = 2.5 giây
            });
        });
    </script>
}