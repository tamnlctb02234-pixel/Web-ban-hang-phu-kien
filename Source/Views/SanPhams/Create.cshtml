@model ASM1_SOF1022.Models.SanPham

@{
    ViewData["Title"] = "Thêm sản phẩm";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

    body {
        background-color: #fffafc;
    }

    .create-card {
        background: white;
        border-radius: 25px;
        padding: 40px;
        box-shadow: 0 10px 30px rgba(255, 77, 141, 0.08);
        border: none;
    }

    .page-title {
        color: #ff4d8d;
        font-weight: bold;
    }

    .form-label {
        font-weight: 600;
        color: #444;
        margin-bottom: 8px;
    }

    .form-control,
    .form-select {
        border-radius: 12px;
        padding: 12px;
        border: 1px solid #eee;
        transition: 0.3s;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #ff4d8d;
            box-shadow: 0 0 0 0.2rem rgba(255, 77, 141, 0.15);
        }

    .btn-pink {
        background-color: #ff4d8d;
        border: none;
        color: white;
        padding: 10px 22px;
        border-radius: 12px;
        font-weight: 600;
        transition: 0.3s;
    }

        .btn-pink:hover {
            background-color: #ff2f78;
            transform: translateY(-2px);
        }

    .btn-back {
        background-color: #f3f3f3;
        color: #555;
        border-radius: 12px;
        padding: 10px 22px;
        font-weight: 600;
        transition: 0.3s;
    }

        .btn-back:hover {
            background-color: #e5e5e5;
        }

</style>

<div class="container py-5">

    <div class="row justify-content-center">

        @if (TempData["success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["success"]
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }

        @if (TempData["error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @TempData["error"]
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>
            </div>
        }

        <div class="col-lg-8">

            <div class="create-card">

                <div class="text-center mb-4">

                    <h2 class="page-title">
                        🧸 Thêm sản phẩm mới
                    </h2>

                    <p class="text-muted">
                        Thêm sản phẩm dễ thương vào cửa hàng Bear & Bunny
                    </p>

                </div>

                <form asp-action="Create" method="post">

                    <div class="mb-4">

                        <label class="form-label">
                            Tên sản phẩm
                        </label>

                        <input asp-for="TenSanPham"
                               class="form-control"
                               placeholder="Nhập tên sản phẩm..." />

                        <span asp-validation-for="TenSanPham" class="text-danger"></span>

                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-4">

                            <label class="form-label">
                                Giá sản phẩm
                            </label>

                            <input asp-for="Gia"
                                   class="form-control"
                                   placeholder="Ví dụ: 150000" />

                            <span asp-validation-for="Gia" class="text-danger"></span>

                        </div>

                        <div class="col-md-6 mb-4">

                            <label class="form-label">
                                Số lượng
                            </label>

                            <input asp-for="SoLuong"
                                   class="form-control"
                                   placeholder="Ví dụ: 10" />

                            <span asp-validation-for="SoLuong" class="text-danger"></span>

                        </div>

                    </div>

                    <div class="mb-4">

                        <label class="form-label">
                            Mô tả sản phẩm
                        </label>

                        <textarea asp-for="MoTa"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Nhập mô tả sản phẩm..."></textarea>

                    </div>

                    <div class="mb-4">

                        <label class="form-label">
                            Hình ảnh
                        </label>

                        <input asp-for="HinhAnh"
                               class="form-control"
                               placeholder="Tên file ảnh..." />

                    </div>

                    <div class="mb-4">

                        <label class="form-label">
                            Danh mục
                        </label>

                        <select asp-for="MaDanhMuc"
                                class="form-select">

                            @foreach (var dm in ViewBag.DanhMucs)
                            {
                                <option value="@dm.MaDanhMuc">
                                    @dm.TenDanhMuc
                                </option>
                            }

                        </select>

                    </div>

                    <div class="d-flex gap-3">

                        <button type="submit"
                                class="btn btn-pink">

                            ➕ Thêm sản phẩm

                        </button>

                        <a asp-action="Index"
                           class="btn btn-back">

                            ← Quay lại

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>