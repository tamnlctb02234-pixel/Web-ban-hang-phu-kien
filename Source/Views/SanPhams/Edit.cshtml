@model ASM1_SOF1022.Models.SanPham

@{
    ViewData["Title"] = "Thêm sản phẩm";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<div class="container mt-5">

    <h2 class="mb-4">Thêm sản phẩm</h2>

    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="MaSanPham" />

        <div class="mb-3">
            <label>Tên sản phẩm</label>
            <input asp-for="TenSanPham" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Giá</label>
            <input asp-for="Gia" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Số lượng</label>
            <input asp-for="SoLuong" class="form-control" />
        </div>

        <div class="mb-3">
            <label>Mô tả</label>
            <textarea asp-for="MoTa" class="form-control"></textarea>
        </div>

        <div class="mb-3">
            <label>Hình ảnh</label>
            <input asp-for="HinhAnh" class="form-control" />
        </div>

        <div class="mb-3">

            <label>Danh mục</label>

            <select asp-for="MaDanhMuc" class="form-control">

                @foreach (var dm in ViewBag.DanhMucs)
                {
                    <option value="@dm.MaDanhMuc">
                        @dm.TenDanhMuc
                    </option>
                }

            </select>

        </div>

        <button type="submit" class="btn btn-success">
            Thêm sản phẩm
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Quay lại
        </a>

    </form>

</div>