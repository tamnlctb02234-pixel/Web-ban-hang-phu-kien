@model IEnumerable<ASM1_SOF1022.Models.SanPham>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<style>

    .page-title {
        color: #ff4d8d;
        font-weight: bold;
    }

    .btn-pink {
        background-color: #ff4d8d;
        color: white;
        border-radius: 12px;
        padding: 10px 18px;
        border: none;
        transition: 0.3s;
    }

        .btn-pink:hover {
            background-color: #ff2f78;
            color: white;
        }

    .product-card {
        border: none;
        border-radius: 20px;
        overflow: hidden;
        background: white;
    }

    .table thead {
        background-color: #fff0f5;
    }

        .table thead th {
            color: #ff4d8d;
            font-weight: 600;
            border: none;
        }

    .table tbody tr {
        transition: 0.2s;
    }

        .table tbody tr:hover {
            background-color: #fff8fb;
        }

    .product-img {
        width: 85px;
        height: 85px;
        object-fit: cover;
        border-radius: 15px;
        border: 2px solid #ffe0eb;
    }

    .price {
        color: #ff4d6d;
        font-weight: bold;
    }

    .category-badge {
        background-color: #ffe0eb;
        color: #ff4d8d;
        padding: 7px 12px;
        border-radius: 20px;
        font-size: 14px;
    }

    .btn-action {
        border-radius: 10px;
        padding: 6px 12px;
    }

</style>

<div class="container mt-5">

    @* ĐÃ THÊM CLASS auto-close-alert ĐỂ JAVASCRIPT NHẬN DIỆN *@
    @if (TempData["success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show auto-close-alert" role="alert">
            @TempData["success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show auto-close-alert" role="alert">
            @TempData["error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="page-title">
                🧸 Quản lý sản phẩm
            </h2>

            <p class="text-muted mb-0">
                Danh sách sản phẩm của Bear & Bunny
            </p>

        </div>

        <a asp-action="Create"
           class="btn btn-pink shadow-sm">

            + Thêm sản phẩm

        </a>

    </div>

    <!-- CARD -->
    <div class="card shadow-sm product-card">

        <div class="card-body p-4">

            <table class="table align-middle">

                <thead>
                    <tr>
                        <th>Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Giá</th>
                        <th>Số lượng</th>
                        <th>Danh mục</th>
                        <th width="170">Chức năng</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <!-- HÌNH -->
                            <td>

                                <img src="~/images/@item.HinhAnh"
                                     class="product-img" />

                            </td>

                            <!-- TÊN -->
                            <td>

                                <div class="fw-bold">
                                    @item.TenSanPham
                                </div>

                                <small class="text-muted">
                                    Gấu bông & phụ kiện
                                </small>

                            </td>

                            <!-- GIÁ -->
                            <td class="price">

                                @String.Format("{0:N0}", item.Gia) VNĐ

                            </td>

                            <!-- SỐ LƯỢNG -->
                            <td>

                                <span class="badge bg-success">
                                    @item.SoLuong
                                </span>

                            </td>

                            <!-- DANH MỤC -->
                            <td>

                                <span class="category-badge">

                                    @item.MaDanhMucNavigation?.TenDanhMuc<!--MaDanhMucNavigation?.TenDanhMuc-->

                                </span>

                            </td>

                            <!-- CHỨC NĂNG -->
                            <td>

                                <div class="d-flex gap-2">

                                    <!-- SỬA -->
                                    <a asp-action="Edit"
                                       asp-route-id="@item.MaSanPham"
                                       class="btn btn-warning btn-sm btn-action">

                                        Sửa

                                    </a>

                                    <!-- XÓA -->
                                    <a asp-action="Delete"
                                       asp-route-id="@item.MaSanPham"
                                       class="btn btn-danger btn-sm btn-action"
                                       onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này không?')">

                                        Xóa

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@* ĐOẠN SCRIPT TỰ ĐỘNG ĐÓNG THÔNG BÁO SAU 2.5 GIÂY *@
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var alerts = document.querySelectorAll('.auto-close-alert');
            alerts.forEach(function (alert) {
                setTimeout(function () {
                    var bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                }, 2500); // 2500 mili giây = 2.5 giây
            });
        });
    </script>
}