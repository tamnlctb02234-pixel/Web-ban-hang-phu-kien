@model IEnumerable<ASM1_SOF1022.Models.SanPham>

@{
    ViewData["Title"] = "Trang chủ";
}

<style>

    .hero {
        background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url('/images/banner.jpg');
        background-size: cover;
        background-position: center;
        height: 500px;
        border-radius: 0 0 40px 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        text-align: center;
    }

        .hero h1 {
            font-size: 60px;
            font-weight: bold;
        }

    .btn-shop {
        background-color: #ff4d8d;
        color: white;
        padding: 12px 28px;
        border-radius: 15px;
        border: none;
        text-decoration: none;
    }

        .btn-shop:hover {
            background-color: #ff2f78;
            color: white;
        }

    .product-card {
        border: none;
        border-radius: 20px;
        overflow: hidden;
        transition: 0.3s;
    }

        .product-card:hover {
            transform: translateY(-5px);
        }

    .product-img {
        height: 250px;
        object-fit: cover;
    }

</style>

<!-- HERO -->

<div class="hero mb-5">

    <div>

        <h1>
            🧸 Bear & Bunny
        </h1>

        <p class="lead mb-4">

            Bộ sưu tập phụ kiện siêu đáng yêu dành cho bạn

        </p>

        <a asp-controller="Shop"
           asp-action="Index"
           class="btn-shop">

            Mua ngay

        </a>

    </div>

</div>

<!-- SẢN PHẨM -->

<div class="container py-5">

    <div class="text-center mb-5">

        <h2 class="fw-bold text-danger">

            ✨ Sản phẩm nổi bật

        </h2>

        <p class="text-muted">

            Những sản phẩm được yêu thích nhất

        </p>

    </div>

    <div class="row g-4">

        @foreach (var item in Model)
        {
            <div class="col-md-3">

                <div class="card shadow-sm product-card h-100">

                    <img src="~/images/@item.HinhAnh"
                         class="card-img-top product-img" />

                    <div class="card-body d-flex flex-column">

                        <span class="badge bg-danger mb-2">

                            @item.MaDanhMucNavigation?.TenDanhMuc

                        </span>

                        <h5 class="fw-bold">

                            @item.TenSanPham

                        </h5>

                        <p class="text-muted small flex-grow-1">

                            @item.MoTa

                        </p>

                        <h5 class="text-danger fw-bold">

                            @String.Format("{0:N0}", item.Gia) VNĐ

                        </h5>

                        <a asp-controller="Shop"
                           asp-action="Details"
                           asp-route-id="@item.MaSanPham"
                           class="btn btn-danger mt-3">

                            Xem chi tiết

                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

</div>