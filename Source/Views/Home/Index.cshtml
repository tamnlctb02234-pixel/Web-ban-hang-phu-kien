@model IEnumerable<ASM1_SOF1022.Models.SanPham>

@{
    ViewData["Title"] = "Trang chủ";
}

<style>

    body {
        background-color: #fff8fb;
    }

    /* HERO */

    .hero {
        background: linear-gradient(135deg, #ffb6d5, #ffd6e7);
        height: 420px;
        border-radius: 0 0 40px 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: white;
        position: relative;
        overflow: hidden;

        position: relative;
        z-index: 1;
    }

        .hero::before {
            content: "🧸";
            position: absolute;
            font-size: 220px;
            opacity: 0.08;
            left: 8%;
            top: 40px;
        }

        .hero::after {
            content: "🎀";
            position: absolute;
            font-size: 180px;
            opacity: 0.08;
            right: 10%;
            bottom: 30px;
        }

        .hero h1 {
            font-size: 70px;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .hero p {
            font-size: 20px;
            margin-bottom: 30px;
        }

    .btn-shop {
        background: white;
        color: #ff4d8d;
        padding: 14px 34px;
        border-radius: 50px;
        text-decoration: none;
        font-weight: 700;
        transition: 0.3s;
        box-shadow: 0 8px 20px rgba(0,0,0,0.1);
    }

        .btn-shop:hover {
            background: #ff4d8d;
            color: white;
            transform: translateY(-3px);
        }

    /* TITLE */

    .section-title h2 {
        color: #ff4d8d;
        font-weight: bold;
        font-size: 38px;
    }

    .section-title p {
        color: gray;
    }

    /* PRODUCT */

    .product-card {
        border: none;
        border-radius: 25px;
        overflow: hidden;
        transition: 0.3s;
        background: white;
        box-shadow: 0 8px 20px rgba(0,0,0,0.08);
    }

        .product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.15);
        }

    .product-img {
        height: 250px;
        object-fit: cover;
        transition: 0.3s;
    }

    .product-card:hover .product-img {
        transform: scale(1.05);
    }

    .badge-category {
        background: #ffe0ec;
        color: #ff2f78;
        padding: 8px 14px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
    }

    .price {
        color: #ff2f78;
        font-size: 24px;
        font-weight: bold;
    }

    .btn-detail {
        background: linear-gradient(45deg, #ff4d8d, #ff7aa8);
        color: white;
        border: none;
        border-radius: 15px;
        padding: 12px;
        text-decoration: none;
        text-align: center;
        transition: 0.3s;
    }

        .btn-detail:hover {
            opacity: 0.9;
            color: white;
        }

</style>

<!-- HERO -->

<div class="hero mb-5">

    <div>

        <h1>
            🧸 Bear & Bunny
        </h1>

        <p>
            Phụ kiện dễ thương dành riêng cho bạn ✨
        </p>

        <a asp-controller="Shop"
           asp-action="Index"
           class="btn-shop">

            Mua ngay 💖

        </a>

    </div>

</div>

<!-- SẢN PHẨM -->

<div class="container py-5">

    <div class="section-title text-center mb-5">

        <h2>
            ✨ Sản phẩm nổi bật
        </h2>

        <p>
            Những sản phẩm được yêu thích nhất
        </p>

    </div>

    <div class="row g-4">

        @foreach (var item in Model)
        {
            <div class="col-lg-3 col-md-6">

                <div class="card product-card h-100">

                    <div class="overflow-hidden">

                        <img src="~/images/@item.HinhAnh"
                             class="card-img-top product-img" />

                    </div>

                    <div class="card-body d-flex flex-column">

                        <div class="mb-3">

                            <span class="badge-category">

                                @item.MaDanhMucNavigation?.TenDanhMuc

                            </span>

                        </div>

                        <h5 class="fw-bold">

                            @item.TenSanPham

                        </h5>

                        <p class="text-muted small flex-grow-1">

                            @item.MoTa

                        </p>

                        <div class="price mb-3">

                            @String.Format("{0:N0}", item.Gia) VNĐ

                        </div>

                        <a asp-controller="Shop"
                           asp-action="Details"
                           asp-route-id="@item.MaSanPham"
                           class="btn-detail">

                            Xem chi tiết

                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

</div>