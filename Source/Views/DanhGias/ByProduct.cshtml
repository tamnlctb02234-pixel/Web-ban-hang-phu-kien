@model ASM1_SOF1022.Models.SanPham

@{
    ViewData["Title"] = "Đánh giá sản phẩm";
}

<div class="container mt-5">

    <div class="d-flex align-items-center gap-4 mb-5">

        <img src="~/images/@Model.HinhAnh"
             width="180"
             class="rounded shadow" />

        <div>

            <h2>@Model.TenSanPham</h2>

            <h4 class="text-danger">
                @String.Format("{0:N0}", Model.Gia) VNĐ
            </h4>

        </div>

    </div>

    <h3 class="mb-4">
        ⭐ Đánh giá sản phẩm
    </h3>

    @if (Model.DanhGia.Any())
    {
        @foreach (var dg in Model.DanhGia)
        {
            <div class="card shadow-sm mb-3 border-0 rounded-4">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <h5 class="fw-bold">
                            @dg.MaKhachHangNavigation?.HoTen
                        </h5>

                        <span class="badge bg-warning text-dark">
                            ⭐ @dg.SoSao
                        </span>

                    </div>

                    <p class="mt-3">
                        @dg.BinhLuan
                    </p>

                    <small class="text-muted">
                        @dg.NgayDanhGia
                    </small>

                </div>

            </div>
        }
    }
    else
    {
        <div class="alert alert-warning">
            Chưa có đánh giá nào
        </div>
    }

</div> 