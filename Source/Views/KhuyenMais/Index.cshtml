@model IEnumerable<ASM1_SOF1022.Models.KhuyenMai>

<div class="container mt-5">

    <div class="d-flex justify-content-between mb-4">

        <h2 class="fw-bold">
            🎁 Khuyến mãi
        </h2>

        <a asp-action="Create"
           class="btn btn-primary">

            + Thêm

        </a>

    </div>

    <div class="card shadow border-0 rounded-4">

        <div class="card-body">

            <table class="table align-middle">

                <thead>
                    <tr>
                        <th>Tên</th>
                        <th>% Giảm</th>
                        <th>Ngày bắt đầu</th>
                        <th>Ngày kết thúc</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @item.TenKhuyenMai
                            </td>

                            <td>
                                @item.PhanTramGiam%
                            </td>

                            <td>
                                @item.NgayBatDau
                            </td>

                            <td>
                                @item.NgayKetThuc
                            </td>

                            <td>

                                <a asp-action="Edit"
                                   asp-route-id="@item.MaKhuyenMai"
                                   class="btn btn-warning btn-sm">

                                    Sửa

                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.MaKhuyenMai"
                                   class="btn btn-danger btn-sm">

                                    Xóa

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>